# Server-only. Do not use VITE_ prefixes for these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
APP_ORIGIN=http://localhost:4173
# Public: allow all verified Google accounts. Only basic Google identity scopes are requested.
AUTH_ACCESS_MODE=public
# Optional restriction when AUTH_ACCESS_MODE=private.
AUTH_ALLOWED_EMAILS=

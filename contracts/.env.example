# Public Sepolia RPC; a provider URL can be used instead.
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Public signer address. Import/use an encrypted Foundry account separately.
DEPLOYER_ADDRESS=
# Optional; defaults to deployer. Keep this same configuration during export.
# STAKE_ADMIN=
# STAKE_VERIFIER=
# STAKE_SETTLER=
# Raw tPRL units (18 decimals); default 1,000,000 tPRL to STAKE_ADMIN.
TEST_PRL_INITIAL_SUPPLY=1000000000000000000000000

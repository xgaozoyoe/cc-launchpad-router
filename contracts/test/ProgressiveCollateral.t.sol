pragma solidity ^0.8.24;
import {TestPRL} from "../src/TestPRL.sol";
import {LaunchStakeV2} from "../src/LaunchStakeV2.sol";
import {ComputeCreditsV2} from "../src/ComputeCreditsV2.sol";
interface CollateralVm {function prank(address) external;function deal(address,uint256) external;function warp(uint256) external;function expectRevert() external;}
contract ProgressiveCollateralTest {
 CollateralVm constant vm=CollateralVm(address(uint160(uint256(keccak256("hevm cheat code")))));
 TestPRL token;LaunchStakeV2 stake;ComputeCreditsV2 credits;address provider=address(0x1234);address buyer=address(0xB0B);bytes32 p=keccak256("progressive-project");
 function setUp()public{vm.warp(1000);token=new TestPRL(address(this),10000 ether);stake=new LaunchStakeV2(token,address(this));credits=new ComputeCreditsV2(address(stake),address(this),address(this),address(this));stake.bindCreditContract(address(credits));stake.grantRole(stake.VERIFIER_ROLE(),address(this));token.transfer(provider,2000 ether);stake.registerProject(p,provider,2000 ether);vm.prank(provider);token.approve(address(stake),2000 ether);vm.prank(provider);stake.stake(p);stake.verifyProject(p);credits.createOffering(p,1000000,1 gwei,keccak256("qwen3-8b-awq"));vm.deal(buyer,1 ether);vm.prank(buyer);credits.buyAndLock{value:1000000 gwei}(p,1000000);}
 function settle(bytes32 batch,bytes32 usage,uint256 amount)public{bytes32[] memory ps=new bytes32[](1);ps[0]=p;address[] memory bs=new address[](1);bs[0]=buyer;uint256[] memory ns=new uint256[](1);ns[0]=amount;bytes32[] memory us=new bytes32[](1);us[0]=usage;credits.settleBatch(batch,ps,bs,ns,us);}
 function testAllCollateralLockedUntilActualBurn()public{(uint i,uint l,uint f,uint r,uint d,uint s)=stake.collateralState(p);require(i==2000 ether&&l==i&&f==0&&r==0&&d==0&&s==1000000);vm.expectRevert();vm.prank(provider);stake.withdrawCollateral(p,1);}
 function testTenPercentDeliveryUnlocksTenPercentAndProviderCanWithdrawPart()public{settle(keccak256("b"),keccak256("u"),100000);(,uint l,uint f,uint r,uint d,)=stake.collateralState(p);require(l==1800 ether&&f==200 ether&&r==0&&d==100000);vm.prank(provider);stake.withdrawCollateral(p,50 ether);(,l,f,r,,)=stake.collateralState(p);require(l==1800 ether&&f==150 ether&&r==50 ether&&token.balanceOf(provider)==50 ether&&token.balanceOf(address(stake))==1950 ether);(uint8 status,uint n,,,)=stake.stakeState(p);require(status==3&&n==2000 ether);}
 function testReplayCannotReleaseOrWithdrawTwice()public{settle(keccak256("b"),keccak256("u"),1);settle(keccak256("b"),keccak256("u"),1);require(credits.providerSettledCredits(p)==1);vm.prank(provider);stake.withdrawCollateral(p,2000000000000000);vm.expectRevert();vm.prank(provider);stake.withdrawCollateral(p,1);}
 function testFullFulfillmentAndWithdrawalKeepProjectVerifiedButNoBalanceRemains()public{settle(keccak256("b"),keccak256("u"),1000000);vm.prank(provider);stake.withdrawCollateral(p,2000 ether);(,uint l,uint f,uint r,,)=stake.collateralState(p);require(l==0&&f==0&&r==2000 ether&&token.balanceOf(address(stake))==0);(uint8 status,,,,)=stake.stakeState(p);require(status==3);}
 function testOtherWalletCannotWithdrawAndLegacyReleaseCannotBypassDelivery()public{settle(keccak256("b"),keccak256("u"),100000);vm.expectRevert();vm.prank(buyer);stake.withdrawCollateral(p,1);vm.expectRevert();stake.releaseStake(p,keccak256("admin shortcut"));vm.expectRevert();vm.prank(provider);stake.withdrawCollateral(p,201 ether);}
 function testCreditSourceCannotBeChangedAfterBinding()public{vm.expectRevert();stake.bindCreditContract(address(credits));LaunchStakeV2 other=new LaunchStakeV2(token,address(this));vm.expectRevert();other.bindCreditContract(address(credits));}
 function testSupplyCannotBeChangedToAccelerateUnlocking()public{vm.expectRevert();credits.createOffering(p,1,1 gwei,keccak256("qwen3-8b-awq"));settle(keccak256("b"),keccak256("u"),1);(,,uint f,,,uint s)=stake.collateralState(p);require(s==1000000&&f==2000000000000000);}
 function testUnstakedAndExpiredRefundHaveNoFreeBalance()public{bytes32 q=keccak256("expired");stake.registerProject(q,provider,10 ether);(uint i,uint l,uint f,uint r,,)=stake.collateralState(q);require(i==0&&l==0&&f==0&&r==0);token.transfer(provider,10 ether);vm.prank(provider);token.approve(address(stake),10 ether);vm.prank(provider);stake.stake(q);vm.warp(87401);vm.prank(provider);stake.refundExpired(q);(i,l,f,r,,)=stake.collateralState(q);require(i==10 ether&&l==0&&f==0&&r==10 ether);}
 function testFuzzCumulativeUnlockConservesAllStake(uint32 delivered,uint32 take)public{uint n=uint(delivered)%1000001;if(n>0)settle(keccak256("b"),keccak256("u"),n);uint earned=2000 ether*n/1000000;uint withdrawn=earned*(uint(take)%1001)/1000;if(withdrawn>0){vm.prank(provider);stake.withdrawCollateral(p,withdrawn);}(uint i,uint l,uint f,uint r,,)=stake.collateralState(p);require(l+f+r==i&&r==withdrawn&&f+r==earned&&token.balanceOf(address(stake))==l+f);}
}

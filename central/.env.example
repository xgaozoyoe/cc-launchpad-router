# Store as .secrets/central.env (git ignored). Use an application DB user.
MONGODB_URI=mongodb://USERNAME:PASSWORD@HOST:27017/launchpad?replicaSet=rs0&authSource=launchpad
MONGODB_DATABASE=launchpad

# Admin review: browser-controlled EOA; must also have LaunchStake VERIFIER_ROLE.
# Missing configuration disables all admin endpoints.
ADMIN_WALLET_ADDRESS=
